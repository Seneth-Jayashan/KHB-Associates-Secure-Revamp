# Placeholders only - copy to backend/.env and fill in real values. NEVER commit .env.
# (Other settings such as DB_URI, SECRET_KEY, EMAIL_* are documented by the credentials fix.)

# Google Gemini (chatbot) - server-side only, never expose to the frontend.
# Create a NEW key in Google AI Studio and restrict it to the Generative Language API.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
